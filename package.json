{
    "name": "bible-app",
    "version": "1.0.9",
    "description": "The Ultimate Offline Bible App for Study and Reflection",
    "main": "dist/main/main.js",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build && electron-builder",
        "build:main": "tsc -p src/main/tsconfig.json",
        "build:renderer": "vite build",
        "preview": "vite preview",
        "electron:dev": "NODE_ENV=development npm run build:main && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
        "electron:build": "npm run build:main && npm run build:renderer && electron-builder --linux snap",
        "electron:build:win": "npm run build:main && npm run build:renderer && electron-builder --win appx --x64 --publish never"
    },
    "author": "karaniph",
    "license": "MIT",
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.0",
        "@types/node": "^20.10.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^4.2.0",
        "concurrently": "^8.2.0",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "typescript": "^5.3.0",
        "vite": "^5.0.0",
        "wait-on": "^7.2.0"
    },
    "dependencies": {
        "better-sqlite3": "^9.2.0"
    },
    "build": {
        "appId": "org.bible.app",
        "productName": "Bible App",
        "icon": "assets/icon.png",
        "directories": {
            "buildResources": "build"
        },
        "linux": {
            "target": "snap",
            "category": "Education",
            "icon": "assets/icon.png"
        },
        "snap": {
            "confinement": "strict",
            "grade": "stable",
            "plugs": [
                "desktop",
                "desktop-legacy",
                "wayland",
                "x11",
                "opengl",
                "unity7",
                "network",
                "network-bind",
                "home",
                "browser-support"
            ]
        },
        "win": {
            "target": "appx",
            "icon": "assets/icon.ico",
            "publisherName": "karaniph",
            "signingHashAlgorithms": ["sha256"]
        },
        "appx": {
            "applicationId": "BibleApp",
            "identityName": "karaniph.BibleApp",
            "publisher": "CN=karaniph",
            "publisherDisplayName": "karaniph",
            "displayName": "Bible App",
            "backgroundColor": "#1a1a2e",
            "showNameOnTiles": true,
            "languages": ["en-US"]
        },
        "electronLanguages": ["en-US"],
        "files": [
            "dist/main/**/*",
            "dist/renderer/**/*",
            "!node_modules/better-sqlite3/deps/**",
            "!node_modules/better-sqlite3/src/**",
            "!node_modules/better-sqlite3/binding.gyp"
        ],
        "extraResources": [
            {
                "from": "assets",
                "to": "assets",
                "filter": ["bible.db"]
            }
        ]
    }
}